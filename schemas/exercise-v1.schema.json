{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relven.invalid/schemas/exercise-v1.schema.json",
  "title": "Relven bundled exercise metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "sourceId", "name", "instructions", "category", "equipment",
    "primaryMuscles", "secondaryMuscles", "movementType", "difficulty",
    "source", "sourceRevision", "revision"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "sourceId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "instructions": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "category": { "type": ["string", "null"] },
    "equipment": { "type": ["string", "null"] },
    "primaryMuscles": { "type": "array", "items": { "type": "string" } },
    "secondaryMuscles": { "type": "array", "items": { "type": "string" } },
    "movementType": { "type": ["string", "null"] },
    "difficulty": { "type": ["string", "null"] },
    "source": { "const": "yuhonas/free-exercise-db" },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "revision": { "const": 1 }
  }
}
